# VozPilot environment configuration
#
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit real keys.

# ---------------------------------------------------------------------------
# Supabase — REQUIRED
# ---------------------------------------------------------------------------
# Both of these are safe to expose to the browser: every request is still
# constrained by Row Level Security. Without them the app renders a setup
# screen instead of failing silently.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Supabase — server-only
# ---------------------------------------------------------------------------
# Bypasses Row Level Security. NEVER prefix with NEXT_PUBLIC_ and never import
# it into a client component. Leave blank unless you have a specific
# server-side task that genuinely needs to act as the service role.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# LLM providers — server-only, OPTIONAL
# ---------------------------------------------------------------------------
# Configure at least one to use a hosted model. With none configured, VozPilot
# falls back to its built-in deterministic reasoning engine and the UI labels
# which engine answered.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

# ---------------------------------------------------------------------------
# Cron — server-only, OPTIONAL
# ---------------------------------------------------------------------------
# Shared secret required by /api/cron/daily-briefing. Set this to a long random
# string and send it as `Authorization: Bearer <CRON_SECRET>` from your scheduler.
CRON_SECRET=
